{
  "name": "global-conflict-watch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-map-worker": "node -e \"require('fs').copyFileSync('node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs','public/maplibre-gl-worker.mjs')\"",
    "predev": "npm run copy-map-worker",
    "dev": "next dev -H 0.0.0.0",
    "prebuild": "npm run copy-map-worker",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "npm run build && next start -H 0.0.0.0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "test:e2e": "node scripts/e2e-auth-check.mjs",
    "db:seed-sample": "tsx scripts/seed-sample.ts",
    "test:unit": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "maplibre-gl": "^6.18.0",
    "mysql2": "^3.24.6",
    "next": "16.4.6",
    "next-intl": "^4.15.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
