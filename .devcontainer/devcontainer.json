{
  "name": "Global Conflict Watch",
  // Single standard container. The two-container setup (app + MariaDB)
  // gave HTTP 502 on the forwarded port, so MariaDB runs inside this
  // container instead (.devcontainer/setup-db.sh).
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",

  "containerEnv": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "GCW site", "onAutoForward": "notify" }
  },

  "postCreateCommand": "npm ci",
  // Every start: make sure MariaDB is running, then apply migrations.
  "postStartCommand": "bash .devcontainer/setup-db.sh && npm run db:migrate",

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"]
    },
    "codespaces": {
      "openFiles": ["docs/TESTING-ON-GITHUB.md"]
    }
  }
}
