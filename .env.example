# Copy to .env.local for development. In production, set these in
# Hostinger hPanel (Node.js app > Environment variables), never in a file.
# Values are filled in as each phase needs them.

# Site
SITE_URL=http://localhost:3000

# Database (Phase 1) - Hostinger MySQL/MariaDB
DATABASE_URL=mysql://user:password@127.0.0.1:3306/gcw
# Set to true when the database requires TLS (e.g. a remote host)
DATABASE_SSL=false

# Admin login (Phase 1) - generate with: openssl rand -base64 32
AUTH_SECRET=

# Scheduled jobs (Phase 2) - shared secret the Hostinger cron sends
CRON_SECRET=

# AI provider (Phase 2) - provider decided at launch
AI_PROVIDER=
AI_API_KEY=

# Email (Phase 4)
EMAIL_API_KEY=
EMAIL_FROM=
